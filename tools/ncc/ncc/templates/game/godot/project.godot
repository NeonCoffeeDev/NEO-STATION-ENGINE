; Neon Coffee - Godot frontend for @NAME@
;
; Open this in Godot 4, build a scene out of boxes, then press "Export to NC"
; in the toolbar. That writes ../scene.json, which `ncc build` turns into the
; data the PS1 runtime renders.

config_version=5

[application]
config/name="@NAME@ (NC frontend)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[editor_plugins]
enabled=PackedStringArray("res://addons/neoncoffee/plugin.cfg")
