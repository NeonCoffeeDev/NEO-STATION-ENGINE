# Build output
build/
dist/
out/
*.elf
*.psexe
*.exe
*.bin
*.cue
*.iso
*.ncpkg

# Python
__pycache__/
*.egg-info/
.venv/
venv/

# Godot
.godot/
.import/
*.import
export_presets.cfg

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Downloaded toolchains (see docs/ROADMAP.md M0)
toolchain/

# Godot generated script UIDs and import cache
*.uid
.godot/

# PS2 build output (the PS1 side already covers .elf via build/)
examples/*/game.elf

# Native intermediate objects
*.o

# Generated VN tables (rebuilt from vn.json)
vn_content.h
vn_kit.h

# Encoded audio banks. Regenerated by `ncc build` from audio/sfx and
# audio/music, and cached against each source file's contents -- six megabytes
# of derived data does not belong in history.
examples/*/src/audio/*.bin
examples/*/src/audio/*.S
examples/*/src/audio/*.h
examples/*/src/audio/*.irx
examples/*/src/nc_events.h
**/src/nc_events.h
**/src/nc_code_generated.h
**/src/nc_ui_generated.h
**/src/ui_skin_data.c
examples/*/src/nc_materials.c
examples/*/src/nc_materials.h
examples/*/.ncc-cache/
