<?xml version="1.0" encoding="utf-8"?>
<!--
	Disc layout for orbit_scene, consumed by mkpsxiso.

	Paths are relative to the BUILD directory. To pull a file from the source tree,
	prefix it with ${PROJECT_SOURCE_DIR}. Names on disc must be 8.3 and the root
	directory holds at most 30 entries.
-->
<iso_project>
	<track type="data">
		<identifiers
			system        ="PLAYSTATION"
			volume        ="ORBIT_SCENE"
			volume_set    ="ORBIT_SCENE"
			publisher     ="NEON COFFEE"
			data_preparer ="NEON COFFEE / PSN00BSDK ${PSN00BSDK_VERSION}"
			application   ="PLAYSTATION"
		/>

		<!--
			Real consoles in some regions want a region license file here. Emulators
			and US consoles generally do not. License data is not redistributable,
			so it is not shipped with PSn00bSDK.
		-->
		<!--<license file="${PROJECT_SOURCE_DIR}/license.dat" />-->

		<directory_tree>
			<file name="SYSTEM.CNF" type="data" source="${PROJECT_SOURCE_DIR}/system.cnf" />
			<file name="GAME.EXE"   type="data" source="game.exe" />

			<!-- Pad the image out so seek times resemble a real pressed disc. -->
			<dummy sectors="1024"/>
		</directory_tree>
	</track>
</iso_project>
