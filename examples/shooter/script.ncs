# @NAME@ - a vertical shooter
#
# Galaga-style: you sit at the bottom, everything comes down at you, and the
# playfield is a narrow column with decorative panels either side. That framing
# is not decoration for its own sake -- a 320x240 screen is far wider than a
# vertical shmup wants, and arcade boards solved it exactly this way.
#
#   MENU     START to play,  SELECT to clear the high score
#   GAME     D-pad to move, X to shoot, START to retry after a game over
#
# There are two scenes, and each has its own sprite list. Sprite order is also
# the draw order reversed -- sprite 0 ends up on top -- which is why the panels
# come first and the starfield last.
#
# Nothing can be created at run time; there is no allocator. Every bullet, enemy
# and explosion exists from the start and is shown, hidden and moved.


# ---- scene 0: the menu ------------------------------------------------------

var M_STAR0   = 2
var M_STARS   = 16

# ---- scene 1: the game ------------------------------------------------------

var PLAYER    = 2
var BULLET0   = 3
var N_BULLETS = 8
var ENEMY0    = 11
var N_ENEMIES = 6
var BOOM0     = 17
var N_BOOMS   = 4
var STAR0     = 21
var N_STARS   = 16

# ---- the playfield ---------------------------------------------------------
# The panels are 64 wide on each side of a 320 screen.

var FIELD_L = 64
var FIELD_R = 256
var SCREEN_H = 240

# ---- tuning ----------------------------------------------------------------

var PLAYER_SPEED = 2
var BULLET_SPEED = 5
var FIRE_DELAY   = 7
var INVULN_TIME  = 90       # frames of mercy after being hit

# ---- saved data ------------------------------------------------------------
# Slot 0 is the high score. Values live in RAM; save_write() puts them on the
# memory card.

var SLOT_HISCORE = 0

# ---- state -----------------------------------------------------------------

var bullet_on: array[8]
var enemy_speed: array[6]
var enemy_drift: array[6]
var boom_timer: array[4]
var star_speed: array[16]

var score = 0
var hiscore = 0
var lives = 3
var cooldown = 0
var dead_timer = 0
var next_boom = 0
var invuln = 0
var saved = 0
var menu_timer = 0


func _ready():
    if scene() == 0:
        ready_menu()
    else:
        ready_game()


func _update():
    if scene() == 0:
        update_menu()
    else:
        update_game()


# ============================================================================
#  MENU
# ============================================================================

func ready_menu():
    menu_timer = 0

    # Pull the high score off the memory card. No card, or no save yet, simply
    # leaves it at zero -- never a reason to stop the player getting in.
    if save_read() == 1:
        hiscore = save_get(SLOT_HISCORE)

    for i in range(M_STARS):
        star_speed[i] = 1 + (i % 3)

    play_music(2)          # track 1 is the game data, so the song is track 2
    print("menu")


func update_menu():
    menu_timer = menu_timer + 1

    for i in range(M_STARS):
        var s = M_STAR0 + i
        var y = sprite_y(s) + star_speed[i]
        if y > SCREEN_H:
            sprite_set_pos(s, FIELD_L + rand(FIELD_R - FIELD_L - 2), 0)
        else:
            sprite_set_pos(s, sprite_x(s), y)

    draw_text(116, 70, "NEON COFFEE")
    draw_text(128, 86, "SQUADRON")

    draw_text(14, 8, "HI")
    draw_num(14, 18, hiscore)

    # Blink the prompt so it reads as waiting rather than frozen.
    if (menu_timer % 60) < 40:
        draw_text(116, 150, "PRESS START")

    draw_text(72, 200, "SELECT CLEARS HI SCORE")

    if btn_pressed(BTN_START):
        goto_scene(1)

    if btn_pressed(BTN_SELECT):
        hiscore = 0
        save_set(SLOT_HISCORE, 0)
        save_write()
        play_sound(0)


# ============================================================================
#  GAME
# ============================================================================

func ready_game():
    score = 0
    lives = 3
    cooldown = 0
    dead_timer = 0
    next_boom = 0
    invuln = 0
    saved = 0

    sprite_set_pos(PLAYER, 152, 190)
    sprite_show(PLAYER)

    for i in range(N_BULLETS):
        bullet_on[i] = 0
        sprite_hide(BULLET0 + i)

    for i in range(N_ENEMIES):
        reset_enemy(i)

    for i in range(N_BOOMS):
        boom_timer[i] = 0
        sprite_hide(BOOM0 + i)

    # Three depths of starfield. The slow ones read as distant, which is the
    # whole trick to making a flat scroll look like space.
    for i in range(N_STARS):
        star_speed[i] = 1 + (i % 3)

    print("game start")


func update_game():
    scroll_stars()

    if lives > 0:
        update_player()
    else:
        update_game_over()

    update_bullets()
    update_enemies()
    update_booms()
    draw_hud()


# ---- starfield --------------------------------------------------------------

func scroll_stars():
    for i in range(N_STARS):
        var s = STAR0 + i
        var y = sprite_y(s) + star_speed[i]
        if y > SCREEN_H:
            # Reappear at the top somewhere else across the playfield, so the
            # field never settles into a visible pattern.
            sprite_set_pos(s, FIELD_L + rand(FIELD_R - FIELD_L - 2), 0)
        else:
            sprite_set_pos(s, sprite_x(s), y)


# ---- player -----------------------------------------------------------------

func update_player():
    var x = sprite_x(PLAYER)
    var y = sprite_y(PLAYER)

    if btn_held(BTN_LEFT):
        x = x - PLAYER_SPEED
    if btn_held(BTN_RIGHT):
        x = x + PLAYER_SPEED
    if btn_held(BTN_UP):
        y = y - PLAYER_SPEED
    if btn_held(BTN_DOWN):
        y = y + PLAYER_SPEED

    sprite_set_pos(PLAYER,
                   clamp(x, FIELD_L, FIELD_R - 16),
                   clamp(y, 100, SCREEN_H - 20))

    # Mercy time after a hit. Blinking shows it is running, and while it is the
    # collision test below is skipped entirely.
    if invuln > 0:
        invuln = invuln - 1
        if (invuln % 8) < 4:
            sprite_hide(PLAYER)
        else:
            sprite_show(PLAYER)
        if invuln == 0:
            sprite_show(PLAYER)

    if cooldown > 0:
        cooldown = cooldown - 1

    if btn_held(BTN_CROSS) and cooldown == 0:
        fire()


func fire():
    # Find a bullet that is not in flight. With none free the shot is dropped,
    # which is what caps how much can be on screen at once.
    for i in range(N_BULLETS):
        if bullet_on[i] == 0:
            bullet_on[i] = 1
            sprite_set_pos(BULLET0 + i,
                           sprite_x(PLAYER) + 6,
                           sprite_y(PLAYER) - 6)
            sprite_show(BULLET0 + i)
            play_sound(0)
            cooldown = FIRE_DELAY
            return 0
    return 0


func update_game_over():
    dead_timer = dead_timer + 1

    # Record the score once, the first frame after dying.
    if saved == 0:
        saved = 1
        if score > hiscore:
            hiscore = score
            save_set(SLOT_HISCORE, hiscore)
            save_write()

    if btn_pressed(BTN_START) and dead_timer > 40:
        goto_scene(0)


# ---- bullets ----------------------------------------------------------------

func update_bullets():
    for i in range(N_BULLETS):
        if bullet_on[i] == 1:
            var s = BULLET0 + i
            var y = sprite_y(s) - BULLET_SPEED
            if y < 0 - 8:
                kill_bullet(i)
            else:
                sprite_set_pos(s, sprite_x(s), y)
                check_bullet_hits(i, sprite_x(s), y)


func kill_bullet(i):
    bullet_on[i] = 0
    sprite_hide(BULLET0 + i)
    sprite_set_pos(BULLET0 + i, 0 - 16, 0 - 16)
    return 0


func check_bullet_hits(i, bx, by):
    for e in range(N_ENEMIES):
        var s = ENEMY0 + e
        if overlap(bx, by, 4, 8, sprite_x(s), sprite_y(s), 16, 16) == 1:
            kill_bullet(i)
            spawn_boom(sprite_x(s), sprite_y(s))
            reset_enemy(e)
            score = score + 10
            play_sound(1)
            shake(3)
            return 0
    return 0


# ---- enemies ----------------------------------------------------------------

func reset_enemy(e):
    # Above the top of the screen, somewhere across the playfield, ready to
    # come down. The stagger keeps them from arriving in a rank.
    enemy_speed[e] = 1 + rand(2)
    enemy_drift[e] = rand(3) - 1
    sprite_set_pos(ENEMY0 + e,
                   FIELD_L + 4 + rand(FIELD_R - FIELD_L - 24),
                   0 - 16 - rand(220))
    sprite_show(ENEMY0 + e)
    return 0


func update_enemies():
    for e in range(N_ENEMIES):
        var s = ENEMY0 + e
        var y = sprite_y(s) + enemy_speed[e]
        var x = sprite_x(s) + enemy_drift[e]

        # Bounce off the panels rather than sliding under them.
        if x < FIELD_L:
            x = FIELD_L
            enemy_drift[e] = 1
        if x > FIELD_R - 16:
            x = FIELD_R - 16
            enemy_drift[e] = 0 - 1

        if y > SCREEN_H:
            reset_enemy(e)
        else:
            sprite_set_pos(s, x, y)

            # The invuln check matters for more than fairness. Without it, the
            # hit below moves the player to the respawn point and the REST of
            # this same loop then tests the remaining enemies against that new
            # position -- so one collision could cost several lives and paint
            # explosions at both the impact and the respawn.
            if lives > 0 and invuln == 0:
                if overlap(x, y, 16, 16,
                           sprite_x(PLAYER), sprite_y(PLAYER), 16, 16) == 1:
                    hit_player()
                    spawn_boom(x, y)
                    reset_enemy(e)


func hit_player():
    lives = lives - 1
    play_sound(2)
    shake(9)
    spawn_boom(sprite_x(PLAYER), sprite_y(PLAYER))
    sprite_set_pos(PLAYER, 152, 190)
    invuln = INVULN_TIME
    if lives <= 0:
        dead_timer = 0
        invuln = 0
        sprite_hide(PLAYER)
        stop_music()
    return 0


# ---- explosions -------------------------------------------------------------

func spawn_boom(x, y):
    # A tiny ring buffer: the oldest explosion is reused, so four can overlap
    # before one is cut short.
    sprite_set_pos(BOOM0 + next_boom, x, y)
    sprite_show(BOOM0 + next_boom)
    boom_timer[next_boom] = 12
    next_boom = next_boom + 1
    if next_boom >= N_BOOMS:
        next_boom = 0
    return 0


func update_booms():
    for i in range(N_BOOMS):
        if boom_timer[i] > 0:
            boom_timer[i] = boom_timer[i] - 1
            if boom_timer[i] == 0:
                sprite_hide(BOOM0 + i)


# ---- helpers ----------------------------------------------------------------

func overlap(ax, ay, aw, ah, bx, by, bw, bh):
    # Axis-aligned box overlap. Two boxes miss if either axis has a gap, so test
    # for the gaps and anything left over is a hit.
    if ax + aw < bx:
        return 0
    if bx + bw < ax:
        return 0
    if ay + ah < by:
        return 0
    if by + bh < ay:
        return 0
    return 1


func draw_hud():
    # The panels have a framed window near the top; the text sits inside it.
    draw_text(14, 8, "SCORE")
    draw_num(14, 18, score)
    draw_text(14, 30, "HI")
    draw_num(14, 40, hiscore)
    draw_text(270, 8, "LIFE")
    draw_num(270, 18, lives)

    if lives <= 0:
        draw_text(124, 112, "GAME OVER")
        if score >= hiscore and score > 0:
            draw_text(112, 128, "NEW HI SCORE")
        if dead_timer > 40:
            draw_text(112, 146, "START = MENU")
